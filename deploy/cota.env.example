# Cota server settings. deploy/install.sh copies this file to /etc/cota/cota.env (readable only by the cota user)
# and fills COTA_UID/COTA_GID. Plain KEY=value lines; avoid $ and quotes in values.

# The host user that owns the checkout (filled by the installer; the image runs as 10001:10001).
COTA_UID=
COTA_GID=
# The image of the rounds: the installer and deploy/update.sh set the tag of the current checkout.
COTA_IMAGE=ghcr.io/thallesownsit/cota
COTA_IMAGE_TAG=
# Folder with node-1.json, node-2.json, node-3.json, operator.json, archive.json and deploy_key.
COTA_SECRETS=/etc/cota/secrets

# Solana endpoint: a dedicated one (e.g. Helius' free plan) is better than the public RPC, which throttles bursts.
RPC=https://api.devnet.solana.com
CLUSTER=devnet

# The nodes' HidroWebService login (ANA river gauges).
ANA_IDENTIFICADOR=
ANA_SENHA=

# 1 = the aggregator stamps in Bitcoin, copies to Arweave, commits and pushes the ledger.
PUSH=1
# 1 = also run the rehearsal of the v3 ledger next to v2 (data/ledger-v3-ensaio; docs/ledger-v3.md). v2 is not touched.
COTA_V3_ENSAIO=0
# Optional: healthchecks.io ping URL (warns when a round fails or does not happen) and the Vercel deploy hook.
HEALTHCHECK_URL=
VERCEL_DEPLOY_HOOK=
